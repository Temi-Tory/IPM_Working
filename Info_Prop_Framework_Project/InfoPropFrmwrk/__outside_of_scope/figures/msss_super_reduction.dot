digraph MSSSReduced {
  graph [rankdir=LR, splines=line, fontsize=14, fontname="Times-Roman"];
  node  [shape=circle, fontsize=12, fontname="Times-Roman", width=0.45, fixedsize=true];
  edge  [fontsize=11, fontname="Times-Roman"];

  ss [label=<s<SUP>*</SUP>>, shape=doublecircle];
  tt [label=<t<SUP>*</SUP>>, shape=doublecircle];

  s1 [label=<s<SUB>1</SUB>>];
  s2 [label=<s<SUB>2</SUB>>];
  u  [label="u"];
  v  [label="v"];
  t1 [label=<t<SUB>1</SUB>>];
  t2 [label=<t<SUB>2</SUB>>];

  ss -> s1 [label="∞"];
  ss -> s2 [label="∞"];
  s1 -> u  [label=<c<SUB>1</SUB>>];
  s2 -> u  [label=<c<SUB>2</SUB>>];
  u  -> v  [label=<c<SUB>3</SUB>>];
  v  -> t1 [label=<c<SUB>4</SUB>>];
  v  -> t2 [label=<c<SUB>5</SUB>>];
  t1 -> tt [label="∞"];
  t2 -> tt [label="∞"];
}
