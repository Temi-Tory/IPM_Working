digraph NodeCapOriginal {
  graph [rankdir=LR, splines=line, fontsize=14, fontname="Times-Roman"];
  node  [shape=circle, fontsize=12, fontname="Times-Roman", width=0.65, fixedsize=true];
  edge  [fontsize=11, fontname="Times-Roman"];

  s [label="s", shape=doublecircle, width=0.45];
  u [label=<u<BR/>(b<SUB>u</SUB>)>];
  v [label=<v<BR/>(b<SUB>v</SUB>)>];
  t [label="t", shape=doublecircle, width=0.45];

  s -> u [label=<c<SUB>su</SUB>>];
  s -> v [label=<c<SUB>sv</SUB>>];
  u -> v [label=<c<SUB>uv</SUB>>];
  u -> t [label=<c<SUB>ut</SUB>>];
  v -> t [label=<c<SUB>vt</SUB>>];
}
