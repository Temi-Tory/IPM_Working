digraph Figure2DegradationTrajectory {
  graph [rankdir=TB, fontsize=11, fontname="Times-Roman", margin=0.2];
  node [shape=box, style="rounded", fontsize=10, fontname="Times-Roman"];
  edge [fontsize=9, fontname="Times-Roman"];
  title [label="Figure 2: Degradation trajectory", shape=plaintext, fontsize=13];
  meta [label="type: line chart\nx-axis: degradation factor alpha\ny-axis: max flow F*", fillcolor="#F4F4F4", style="rounded,filled"];
  title -> meta [arrowhead=none, color="#888888"];
  series_1 [label="Config A points: (1.0, 37.0), (0.9, 33.3), (0.8, 29.6), (0.7, 25.9), (0.6, 22.2), (0.5,\n18.5)"];
