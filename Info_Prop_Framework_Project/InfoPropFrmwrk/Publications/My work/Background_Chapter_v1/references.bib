% Full text read directly, confirming the earlier abstract-only characterisation without
% correction: activity-on-arc project network, exact project reliability via decomposition into
% upper/lower boundary-point subsets evaluated by inclusion-exclusion, no critical-path/float
% computation, no edge-capacity flow network, every activity state a discrete random variable
% with a given probability (never an interval or p-box). Case study: 13-activity
% manufacturing-line construction project in Chengdu, China; reported project reliability
% 0.906411 at T = 135 days, B = 118,000 CNY, validated against full enumeration of 28,311,552
% state vectors (verification note, not rendered; full provenance in INTEGRATION_NOTES.md).
@article{huang2020exact,
  author  = {Huang, Ding-Hsiang and Huang, Cheng-Fu and Lin, Yi-Kuei},
  title   = {Exact Project Reliability for a Multi-State Project Network Subject to Time and Budget Constraints},
  journal = {Reliability Engineering \& System Safety},
  volume  = {195},
  pages   = {106744},
  year    = {2020},
  doi     = {10.1016/j.ress.2019.106744}
}

