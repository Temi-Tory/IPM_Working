// Fig — frame 2: root diamond at join 8; fork 1 conditioned (filled black); all nine edges in span.
digraph nested_outer {
  rankdir=TB; nodesep=0.65; ranksep=0.5;
  node [shape=circle, fontname="Helvetica", fontsize=18, width=0.58, fixedsize=true, penwidth=1.4];
  edge [penwidth=2.4, arrowsize=0.9];
  1 [style=filled, fillcolor=black, fontcolor=white, penwidth=3];
  3 [penwidth=3];
  6 [style=filled, fillcolor=gray85];
  8 [style=filled, fillcolor=gray85, penwidth=3];
  1 -> 2; 1 -> 3;
  3 -> 4; 3 -> 5;
  4 -> 6; 5 -> 6;
  6 -> 7;
  2 -> 8; 7 -> 8;
}
