// Example C: factorised join — two independent correlated groups at join 7 (bold = the two
// constituent diamonds) plus the unrelated source 8 as a non-diamond parent.
digraph factorised {
  rankdir=TB; nodesep=0.7; ranksep=0.55;
  node [shape=circle, fontname="Helvetica", fontsize=18, width=0.62, fixedsize=true, penwidth=1.4];
  edge [penwidth=1.4, arrowsize=0.9];
  1 [penwidth=3]; 2 [penwidth=3];
  3; 4; 5; 6; 8;
  7 [style=filled, fillcolor=gray85];
  1 -> 3 [penwidth=2.6]; 1 -> 4 [penwidth=2.6];
  2 -> 5 [penwidth=2.6]; 2 -> 6 [penwidth=2.6];
  3 -> 7 [penwidth=2.6]; 4 -> 7 [penwidth=2.6];
  5 -> 7 [penwidth=2.6]; 6 -> 7 [penwidth=2.6];
  8 -> 7;
}
