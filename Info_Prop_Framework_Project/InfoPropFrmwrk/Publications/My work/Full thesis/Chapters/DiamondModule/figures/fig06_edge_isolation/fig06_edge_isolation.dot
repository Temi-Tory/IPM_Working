// Fig — edge isolation at join 5 in context E={1}: node 1 (conditioned upstream) is excluded from
// group G={3,4}; its direct edge (1,5) is blocked by the fourth filter clause; bold edges = the
// nested diamond's edgelist.
digraph edge_isolation {
  rankdir=TB; nodesep=0.75; ranksep=0.6;
  node [shape=circle, fontname="Helvetica", fontsize=18, width=0.58, fixedsize=true, penwidth=1.4];
  edge [arrowsize=0.9];
  1 [style=filled, fillcolor=black, fontcolor=white];
  2 [penwidth=3];
  5 [style=filled, fillcolor=gray85, penwidth=3];
  1 -> 3 [penwidth=2.6];
  2 -> 3 [penwidth=2.6]; 2 -> 4 [penwidth=2.6];
  3 -> 5 [penwidth=2.6]; 4 -> 5 [penwidth=2.6];
  1 -> 5 [style=dashed, color=gray35, penwidth=1.8, label="  blocked", fontsize=15, fontname="Helvetica-Oblique", fontcolor=gray20];
}
