// A small treatment process (left) and its DAG model (right). The duplicated treatment
// stage becomes a reconvergent pair of routes.
digraph mapping {
  rankdir=TB; nodesep=0.55; ranksep=0.6;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=16, penwidth=1.4];
  edge [penwidth=1.4, arrowsize=0.9];

  subgraph cluster_system {
    label="process"; fontsize=17; style=dashed;
    node [shape=box, style=rounded];
    Intake -> Pumping;
    Pumping -> "Treatment A";
    Pumping -> "Treatment B";
    "Treatment A" -> Blending;
    "Treatment B" -> Blending;
    Blending -> Distribution;
  }

  subgraph cluster_model {
    label="model"; fontsize=17; style=dashed;
    node [shape=circle, width=0.5];
    1 -> 2;
    2 -> 3;
    2 -> 4;
    3 -> 5;
    4 -> 5;
    5 -> 6;
  }
}
