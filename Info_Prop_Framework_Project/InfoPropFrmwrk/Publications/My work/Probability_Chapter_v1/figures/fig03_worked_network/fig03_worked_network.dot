// Fig — the multi-level worked network. Sources S1,S2,S3 double-bordered; forks 1,7,14 bold;
// joins 4,6,11,12 and target T shaded.
digraph worked_network {
  rankdir=TB; nodesep=0.5; ranksep=0.55;
  node [shape=circle, fontname="Helvetica", fontsize=16, width=0.56, fixedsize=true, penwidth=1.4];
  edge [penwidth=1.3, arrowsize=0.85];
  S1 [shape=doublecircle, width=0.5];
  S2 [shape=doublecircle, width=0.5];
  S3 [shape=doublecircle, width=0.5];
  1 [penwidth=3];
  7 [penwidth=3];
  14 [penwidth=3];
  4 [style=filled, fillcolor=gray85];
  6 [style=filled, fillcolor=gray85];
  11 [style=filled, fillcolor=gray85];
  12 [style=filled, fillcolor=gray85];
  T [style=filled, fillcolor=gray85];
  S2 -> 14;
  14 -> 13; 14 -> 15;
  S1 -> 1;
  1 -> 2; 1 -> 3; 1 -> 4;
  2 -> 5;
  5 -> 6; 3 -> 6; 13 -> 6;
  15 -> 12; 6 -> 12;
  S3 -> 7;
  7 -> 8; 7 -> 9;
  8 -> 4;
  4 -> 10;
  10 -> 11; 9 -> 11;
  12 -> T; 11 -> T;
}
