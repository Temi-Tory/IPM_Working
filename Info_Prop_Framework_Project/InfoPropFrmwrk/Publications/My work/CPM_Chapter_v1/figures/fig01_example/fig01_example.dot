// Running example: 4-node diamond, durations 1,5,2,1. LongestPath critical 1-2-4 (bold),
// ShortestPath optimal 1-3-4.
digraph example {
  rankdir=TB; nodesep=0.9; ranksep=0.7;
  node [shape=circle, style=filled, fillcolor=white, fontname="Helvetica", fontsize=18, penwidth=1.4, width=0.62];
  edge [penwidth=1.4, arrowsize=0.9];
  1 [label=<1<BR/><FONT POINT-SIZE="13">d=1</FONT>>, penwidth=2.6];
  2 [label=<2<BR/><FONT POINT-SIZE="13">d=5</FONT>>, penwidth=2.6];
  3 [label=<3<BR/><FONT POINT-SIZE="13">d=2</FONT>>];
  4 [label=<4<BR/><FONT POINT-SIZE="13">d=1</FONT>>, penwidth=2.6];
  1 -> 2 [penwidth=2.6];
  1 -> 3;
  2 -> 4 [penwidth=2.6];
  3 -> 4;
}
