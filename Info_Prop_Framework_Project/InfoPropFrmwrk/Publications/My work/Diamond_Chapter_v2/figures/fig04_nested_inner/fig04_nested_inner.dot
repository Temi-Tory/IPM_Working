// Fig — frame 3: recursion at join 6 in context E={1}; fork 3 selected; inner diamond bold;
// edge (1,3) cut by the boundary clause; outer remainder greyed.
digraph nested_inner {
  rankdir=TB; nodesep=0.65; ranksep=0.5;
  node [shape=circle, fontname="Helvetica", fontsize=18, width=0.58, fixedsize=true, penwidth=1.4];
  edge [arrowsize=0.9];
  1 [style=filled, fillcolor=black, fontcolor=white];
  3 [style=filled, fillcolor=black, fontcolor=white, penwidth=3];
  6 [style=filled, fillcolor=gray85, penwidth=3];
  2 [color=gray60, fontcolor=gray55]; 7 [color=gray60, fontcolor=gray55]; 8 [color=gray60, fontcolor=gray55];
  1 -> 3 [style=dashed, color=gray45, penwidth=1.6, label="cut", fontsize=15, fontname="Helvetica-Oblique", fontcolor=gray30];
  1 -> 2 [color=gray60, penwidth=1.2]; 2 -> 8 [color=gray60, penwidth=1.2];
  6 -> 7 [color=gray60, penwidth=1.2]; 7 -> 8 [color=gray60, penwidth=1.2];
  3 -> 4 [penwidth=2.6]; 3 -> 5 [penwidth=2.6];
  4 -> 6 [penwidth=2.6]; 5 -> 6 [penwidth=2.6];
}
