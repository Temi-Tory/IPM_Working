digraph ToySISO {
  graph [rankdir=LR, splines=line, fontsize=14, fontname="Times-Roman"];
  node  [shape=circle, fontsize=13, fontname="Times-Roman", width=0.45, fixedsize=true];
  edge  [fontsize=11, fontname="Times-Roman"];

  s [label="s", shape=doublecircle];
  a [label="a"];
  b [label="b"];
  t [label="t", shape=doublecircle];

  s -> a [label=<c<SUB>sa</SUB>>];
  s -> b [label=<c<SUB>sb</SUB>>];
  a -> t [label=<c<SUB>at</SUB>>];
  b -> t [label=<c<SUB>bt</SUB>>];
  a -> b [label=<c<SUB>ab</SUB>>];
}
