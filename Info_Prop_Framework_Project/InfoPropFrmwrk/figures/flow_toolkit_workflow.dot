digraph FlowToolkitWorkflow {
  graph [
    rankdir=TB,
    splines=ortho,
    fontsize=13,
    fontname="Times-Roman",
    nodesep=0.25,
    ranksep=0.55,
    pad=0.05,
    compound=true
  ];
  node [
    shape=box,
    style="rounded",
    fontsize=10,
    fontname="Times-Roman",
    width=2.9,
    height=0.55,
    fixedsize=true
  ];
  edge [fontsize=9, fontname="Times-Roman", arrowsize=0.7, color="#222222"];

  input      [label="Input Processing Module\nnetwork metadata"];
  orchestr   [label="CapacityAnalysisKit orchestrator"];
  baseline_p [label="Super-terminal reduction"];
  baseline_r [label="Core Flow Module"];
  nodecap_p  [label="Node-capacity transformation"];
  fdfmly     [label="Flow Decomposition Module"];
  remap_out  [label="Final Remapping Stage"];
  aggregate  [label="CapacityAnalysisKitResult\n(integrated analysis object)"];

  cr_family [
    label="Capacity Response family\n- Sensitivity Module\n- Failure Impact Module\n- Parametric Threshold Module",
    style="rounded",
    width=3.6,
    height=0.95
  ];
  st_family [
    label="Structural & Cut Topology family\n- Structural Module\n- MinCut Utility Module\n- Global Connectivity Module",
    style="rounded",
    width=3.6,
    height=0.95
  ];

  subgraph cluster_outputs {
    style=dashed;
    color="#888888";
    fontsize=10;
    fontname="Times-Roman";
    out_flow [label="Flow outputs\nmax flow, sink allocations, residual capacities"];
    out_cut  [label="Cut and structure outputs\nmin-cut sets, bottlenecks, connectivity"];
    out_adv  [label="Advanced outputs\nfailure impact, thresholds, sensitivity, decomposition"];
  }

  input      -> orchestr;
  orchestr   -> baseline_p;
  orchestr   -> nodecap_p;
  baseline_p -> baseline_r;
  nodecap_p  -> baseline_r;

  baseline_r -> fdfmly    
  baseline_r -> cr_family [tailport=s];
  baseline_r -> st_family [tailport=e];


 cr_family -> remap_out 
 
 fdfmly -> remap_out 
 st_family -> remap_out 
    baseline_r -> remap_out 


  remap_out -> aggregate;
  aggregate -> out_flow;
  aggregate -> out_cut;
  aggregate -> out_adv;

  { rank=same; cr_family; st_family; fdfmly; }
}